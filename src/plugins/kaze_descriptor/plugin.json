{
  "name": "KAZE",
  "category": "descriptor",
  "version": "1.0.0",
  "description": "基于非线性尺度空间的 KAZE 关键点检测与描述子提取",
  "params": [
    { "name": "extended", "type": "bool", "default": false, "group": "KAZE", "tooltip": "是否使用扩展(128维)描述子" },
    { "name": "upright", "type": "bool", "default": false, "group": "KAZE", "tooltip": "是否使用无旋转 Upright 描述子" },
    { "name": "threshold", "type": "double", "default": 0.001, "min": 0.0, "group": "KAZE", "tooltip": "检测响应阈值" },
    { "name": "nOctaves", "type": "int", "default": 4, "min": 1, "max": 16, "group": "KAZE" },
    { "name": "nOctaveLayers", "type": "int", "default": 4, "min": 1, "max": 16, "group": "KAZE" },
    { "name": "diffusivity", "type": "int", "default": 1, "min": 0, "max": 3, "group": "KAZE", "enumValues": ["PM_G1", "PM_G2", "WEICKERT", "CHARBONNIER"], "tooltip": "扩散类型：0=PM_G1 1=PM_G2 2=WEICKERT 3=CHARBONNIER" },
    { "name": "maxFeatures", "type": "int", "default": 0, "min": 0, "group": "KAZE", "tooltip": "最大特征点数量，0 表示不限制" }
  ]
}